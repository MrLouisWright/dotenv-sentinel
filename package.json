{
  "name": "dotenv-sentinel",
  "version": "1.0.0",
  "description": "Validate .env files against .env.example or a JSON schema (missing, empty, extra and mistyped variables), flag weak and default secrets, real secrets in example files, and .env files that are committed, in git history or not gitignored. Never prints secret values. dotenv-linter style formatting checks, per-environment file layering, and an envalid-style cleanEnv() runtime validator with a zod adapter. CLI, library and GitHub Action.",
  "keywords": [
    "dotenv",
    "env",
    "environment-variables",
    "env-file",
    "secrets",
    "config-validation",
    "schema",
    "gitignore",
    "secret-scanning",
    "security",
    "sarif",
    "cli",
    "github-action"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "funding": {
    "type": "stripe",
    "url": "https://donate.stripe.com/aFa00lek3cvX4Ds2Fk9EI0b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/dotenv-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/dotenv-sentinel/issues"
  },
  "homepage": "https://mrlouiswright.github.io/dotenv-sentinel/",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./src/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dotenv-sentinel": "bin/dotenv-sentinel.js"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bundle-secret-guard": "^1.1.0"
  }
}
